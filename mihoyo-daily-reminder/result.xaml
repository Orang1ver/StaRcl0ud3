<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启动结果"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FFF2C463"/>
            <Setter Property="Foreground" Value="#FF1A202E"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18"
            CornerRadius="22"
            BorderThickness="1"
            BorderBrush="#30FFFFFF">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF343B5F" Offset="0"/>
                <GradientStop Color="#FF1C2034" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="26,22,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Border Background="#26F3C766"
                        CornerRadius="6"
                        Padding="9,4"
                        HorizontalAlignment="Left">
                    <TextBlock Text="已完成处理"
                               FontSize="10.5"
                               Foreground="#FFFFDE9E"/>
                </Border>
                <TextBlock Text="启动结果"
                           Margin="0,9,0,0"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          MaxHeight="300"
                          Margin="0,16,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="MessageRows"/>
            </ScrollViewer>

            <Button x:Name="OKButton"
                    Grid.Row="2"
                    Height="44"
                    Margin="0,16,0,0"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}"
                    Content="好的，知道了"/>
        </Grid>
    </Border>
</Window>
