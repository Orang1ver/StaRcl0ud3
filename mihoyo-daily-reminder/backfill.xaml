<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="补录打卡"
        Width="500"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FFF2C463"/>
            <Setter Property="Foreground" Value="#FF1A202E"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFB7C2DE"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1CFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFA9B4D4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18"
            CornerRadius="22"
            BorderThickness="1"
            BorderBrush="#30FFFFFF">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF343B5F" Offset="0"/>
                <GradientStop Color="#FF1C2034" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="26,18,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0">
                <StackPanel>
                    <Border Background="#26F3C766" CornerRadius="6" Padding="9,4" HorizontalAlignment="Left">
                        <TextBlock Text="补录 / 修改" FontSize="10.5" Foreground="#FFFFDE9E"/>
                    </Border>
                    <TextBlock Text="补录打卡" Margin="0,9,0,0" FontSize="20" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock x:Name="BackfillHintText" Margin="0,5,0,0" FontSize="12"
                               Foreground="#FFB7C2DE"/>
                </StackPanel>
                <Button x:Name="CloseButton" Width="32" Height="30" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Style="{StaticResource TitleButton}" Content="✕"
                        ToolTip="关闭" AutomationProperties.Name="关闭窗口"/>
            </Grid>

            <!-- 每天的记录行（脚本动态填充） -->
            <ScrollViewer Grid.Row="1" MaxHeight="468" Margin="0,14,0,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="BackfillRows"/>
            </ScrollViewer>

            <!-- 底部说明 + 按钮 -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="补上的日子会按当天的连击倍率补发代币和 XP；取消勾选再保存，就能改掉记错的那天。"
                           FontSize="11" Foreground="#FF9AA6C6" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CancelButton" Grid.Column="0" Height="42" Margin="0,0,5,0"
                        Style="{StaticResource GhostButton}" Content="取消"/>
                <Button x:Name="SaveButton" Grid.Column="1" Height="42" Margin="5,0,0,0"
                        Style="{StaticResource PrimaryButton}" Content="保存"
                        AutomationProperties.Name="保存补录"/>
            </Grid>
        </Grid>
    </Border>
</Window>
