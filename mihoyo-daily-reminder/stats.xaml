<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打卡记录"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="CloseButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFA9B4D4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FFF2C463"/>
            <Setter Property="Foreground" Value="#FF1A202E"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18"
            CornerRadius="22"
            BorderThickness="1"
            BorderBrush="#30FFFFFF">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF343B5F" Offset="0"/>
                <GradientStop Color="#FF1C2034" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="26,22,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部 -->
            <Grid Grid.Row="0">
                <StackPanel>
                    <Border Background="#26F3C766"
                            CornerRadius="6"
                            Padding="9,4"
                            HorizontalAlignment="Left">
                        <TextBlock Text="打卡统计"
                                   FontSize="10.5"
                                   Foreground="#FFFFDE9E"/>
                    </Border>
                    <TextBlock Text="每日打卡记录"
                               Margin="0,9,0,0"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock x:Name="TodayText"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="#FFB7C2DE"/>
                </StackPanel>

                <Button x:Name="CloseButton"
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Style="{StaticResource CloseButton}"
                        Content="✕"/>
            </Grid>

            <!-- 三个数字 -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,14,0,0">
                <Border CornerRadius="14"
                        Background="#1FFFFFFF"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        Margin="0,0,5,0"
                        Padding="0,12">
                    <StackPanel>
                        <TextBlock x:Name="StreakValue"
                                   Text="0"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#FFFFD98A"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="连续天数"
                                   Margin="0,2,0,0"
                                   FontSize="11.5"
                                   Foreground="#FFB7C2DE"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="14"
                        Background="#1FFFFFFF"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        Margin="5,0"
                        Padding="0,12">
                    <StackPanel>
                        <TextBlock x:Name="TotalValue"
                                   Text="0"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#FF9CF3D6"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="累计天数"
                                   Margin="0,2,0,0"
                                   FontSize="11.5"
                                   Foreground="#FFB7C2DE"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="14"
                        Background="#1FFFFFFF"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        Margin="5,0,0,0"
                        Padding="0,12">
                    <StackPanel>
                        <TextBlock x:Name="BestValue"
                                   Text="0"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#FFB9D7FF"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="最长连续"
                                   Margin="0,2,0,0"
                                   FontSize="11.5"
                                   Foreground="#FFB7C2DE"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 称号 / 下一枚徽章 -->
            <Border Grid.Row="2"
                    Margin="0,12,0,0"
                    CornerRadius="12"
                    Background="#1FFFFFFF"
                    BorderBrush="#24FFFFFF"
                    BorderThickness="1"
                    Padding="14,10">
                <StackPanel>
                    <TextBlock x:Name="TitleText"
                               FontSize="12.5"
                               Foreground="#FFFFDE9E"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="NextBadgeText"
                               Margin="0,4,0,0"
                               FontSize="11.5"
                               Foreground="#FF9CF3D6"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 徽章 -->
            <WrapPanel x:Name="BadgesPanel"
                       Grid.Row="3"
                       Margin="0,12,0,0"
                       HorizontalAlignment="Center"/>

            <!-- 日历 -->
            <StackPanel Grid.Row="4" Margin="0,14,0,0">
                <TextBlock Text="最近 5 周（金色为已打卡）"
                           FontSize="11.5"
                           Foreground="#FFB7C2DE"
                           Margin="0,0,0,7"/>
                <UniformGrid Columns="7">
                    <TextBlock Text="一" FontSize="10.5" Foreground="#FFA6B1CE" HorizontalAlignment="Center"/>
                    <TextBlock Text="二" FontSize="10.5" Foreground="#FFA6B1CE" HorizontalAlignment="Center"/>
                    <TextBlock Text="三" FontSize="10.5" Foreground="#FFA6B1CE" HorizontalAlignment="Center"/>
                    <TextBlock Text="四" FontSize="10.5" Foreground="#FFA6B1CE" HorizontalAlignment="Center"/>
                    <TextBlock Text="五" FontSize="10.5" Foreground="#FFA6B1CE" HorizontalAlignment="Center"/>
                    <TextBlock Text="六" FontSize="10.5" Foreground="#FFA6B1CE" HorizontalAlignment="Center"/>
                    <TextBlock Text="日" FontSize="10.5" Foreground="#FFA6B1CE" HorizontalAlignment="Center"/>
                </UniformGrid>
                <UniformGrid x:Name="CalendarGrid" Columns="7" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 最近打卡 -->
            <StackPanel Grid.Row="5" Margin="0,12,0,0">
                <TextBlock Text="最近的 4 次打卡"
                           FontSize="11.5"
                           Foreground="#FFB7C2DE"
                           Margin="0,0,0,7"/>
                <StackPanel x:Name="RecentPanel"/>
            </StackPanel>

            <Button x:Name="OKButton"
                    Grid.Row="6"
                    Height="44"
                    Margin="0,14,0,0"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}"
                    Content="关闭"/>
        </Grid>
    </Border>
</Window>
